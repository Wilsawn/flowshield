# ── Flow Blockchain ──────────────────────────────
CONTRACT_ADDRESS=0x93c691a98b975493
FLOW_NETWORK=testnet
FLOW_ACCESS_NODE=https://rest-testnet.onflow.org
FLOW_PRIVATE_KEY=               # Deployer private key hex (no 0x prefix). Not needed locally if .pkey file exists.

# ── Server ───────────────────────────────────────
PORT=3001
BACKEND_PORT=3002

# ── AI (Builder Copilot + Regulatory Radar) ──────
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── KYC (Veriff) ─────────────────────────────────
VERIFF_API_KEY=
VERIFF_SHARED_SECRET=

# ── Database (Supabase) ─────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Frontend (Vite env vars) ─────────────────────
VITE_API_URL=                   # Backend URL, e.g. https://your-backend.up.railway.app
VITE_SUPABASE_URL=              # Same as SUPABASE_URL
VITE_SUPABASE_ANON_KEY=         # Supabase anon (public) key — safe for browser

# ── Stripe (Subscription Payments) ───────────────
STRIPE_SECRET_KEY=              # sk_test_... or sk_live_...
STRIPE_GROWTH_PRICE_ID=         # Optional — Stripe Price ID for Growth tier
STRIPE_SCALE_PRICE_ID=          # Optional — Stripe Price ID for Scale tier
FRONTEND_URL=                   # For Stripe redirect, e.g. https://flowshield-io.netlify.app
