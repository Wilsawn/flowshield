# FlowShield Environment Variables

# Claude API (for Builder Copilot and Regulatory Radar)
CLAUDE_API_KEY=your_claude_api_key_here

# Flow Network
FLOW_NETWORK=emulator
FLOW_ACCESS_NODE=http://localhost:8888

# Flow Testnet (uncomment for testnet deployment)
# FLOW_NETWORK=testnet
# FLOW_ACCESS_NODE=https://rest-testnet.onflow.org
# FLOW_ACCOUNT_ADDRESS=your_testnet_address
# FLOW_PRIVATE_KEY=your_testnet_private_key

# Backend
PORT=3001
