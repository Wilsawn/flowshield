# FlowShield Backend Environment Variables
# Copy this to .env and fill in your values.

# ── Flow Blockchain ──────────────────────────────
FLOW_NETWORK=testnet
CONTRACT_ADDRESS=0x93c691a98b975493
FLOW_PRIVATE_KEY=               # Deployer private key hex (no 0x prefix). Not needed locally if .pkey file exists.
INITIAL_FUND_AMOUNT=            # FLOW to send each new user (default: 10.0 testnet, 0.001 mainnet)
DAILY_FUND_CAP=                 # Max FLOW to distribute per day (default: 1000.0 testnet, 1.0 mainnet)

# ── Server ───────────────────────────────────────
PORT=3002
FRONTEND_URL=http://localhost:3000

# ── Security (required in production) ────────────
KEY_ENCRYPTION_KEY=             # 32-byte hex key for encrypting custodial private keys at rest
JWT_SECRET=                     # Secret for signing session tokens (min 32 chars)

# ── Database (Supabase) ─────────────────────────
# Get these from https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── AI (Builder Copilot + Regulatory Radar) ──────
CLAUDE_API_KEY=                 # Optional — copilot + radar fall back to built-in responses without it
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── KYC (Veriff) ─────────────────────────────────
VERIFF_API_KEY=                 # Get from https://station.veriff.com (15-day free trial)
VERIFF_SHARED_SECRET=

# ── Anomaly Monitor Thresholds (optional) ────────
ANOMALY_HIGH_FREQ_TXS=500
ANOMALY_EXTREME_BALANCE=1000000
ANOMALY_MAX_KEYS=5
ANOMALY_DORMANT_BALANCE=10000

# ── Stripe (optional) ───────────────────────────
STRIPE_SECRET_KEY=
STRIPE_GROWTH_PRICE_ID=
STRIPE_SCALE_PRICE_ID=
