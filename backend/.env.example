# FlowShield Backend Environment Variables
# Copy this to .env and fill in your values

# Flow Network
FLOW_NETWORK=testnet
CONTRACT_ADDRESS=0x93c691a98b975493

# Server
PORT=3002
FRONTEND_URL=http://localhost:3001

# Veriff KYC (get these from https://station.veriff.com — 15-day free trial)
VERIFF_API_KEY=
VERIFF_SHARED_SECRET=

# Claude API (optional — copilot + radar fallback to built-in responses without it)
CLAUDE_API_KEY=
