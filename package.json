{
  "name": "flowshield",
  "version": "0.1.0",
  "description": "Privacy-preserving compliance infrastructure for DeFi on Flow",
  "scripts": {
    "emulator": "flow emulator start",
    "deploy:emulator": "flow project deploy --network emulator",
    "deploy:testnet": "flow project deploy --network testnet",
    "test": "flow test cadence/tests/",
    "backend": "cd backend && node api/server.js",
    "frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run emulator\" \"npm run backend\" \"npm run frontend\""
  },
  "dependencies": {
    "@onflow/fcl": "^1.12.0",
    "@onflow/types": "^1.4.0",
    "express": "^4.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "keywords": [
    "flow",
    "defi",
    "compliance",
    "zk-proofs",
    "cadence",
    "kyc"
  ],
  "license": "MIT"
}
